VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Add these in Netlify: Site configuration → Environment variables.
# Never commit real secret values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Create an inbound webhook workflow in GoHighLevel and paste its URL here.
GHL_WEBHOOK_URL=

# Server-only email settings for Hostinger PHP endpoints. Never prefix secrets with VITE_.
RESEND_API_KEY=your-resend-api-key
RESULT_EMAIL_FROM=Iman Trucking School <results@your-verified-domain.com>
APPLICATION_EMAIL_TO=info@imantruckingschool.com
APPLICATION_EMAIL_FROM=Iman Trucking School <applications@your-verified-domain.com>
